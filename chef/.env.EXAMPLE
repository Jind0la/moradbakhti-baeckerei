# Environment variables for baeckerei-chef-agent
# Copy this file to .env and fill in your values:
#   cp .env.EXAMPLE .env

# Mistral AI (EU, DSGVO-konform) — https://console.mistral.ai/api-keys/
# Required
MISTRAL_API_KEY=*** Telegram Bot Token für den CHEF-Bot — https://t.me/BotFather
# WICHTIG: Separater Bot als der Kunden-Bot!
# Optional — only needed for Telegram messaging
TELEGRAM_BOT_TOKEN=*** Data directory — GLEICHES Verzeichnis wie Kunden-Bot!
# Required
KMU_DATA_DIR=/opt/baeckerei-data
