# Environment variables for baeckerei-agent
# Copy this file to .env and fill in your values:
#   cp .env.EXAMPLE .env

# DeepSeek API Key — https://platform.deepseek.com/api_keys
# Required
DEEPSEEK_API_KEY=sk-...

# Telegram Bot Token — https://t.me/BotFather
# Optional — only needed for Telegram messaging
TELEGRAM_BOT_TOKEN=

# Data directory for products and orders
# Required
KMU_DATA_DIR=/opt/baeckerei-data